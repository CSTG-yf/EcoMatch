{
  "name": "best_bank_on",
  "description": "Best-known SuperSonic bank-on NL2SQL runtime for EcoMatch bank path (post H-04 / dual-share / province-LT routing).",
  "asOf": "2026-08-08",
  "branchHint": "experiment/bank-path-ablation",
  "antiCheat": {
    "noTrainGoldFewShots": true,
    "noTrainIdHardcodedBuilders": true,
    "noGoldSqlInPrompts": true,
    "rulesDoc": "AGENTS.md"
  },
  "agent": {
    "agentId": 33,
    "note": "Local bank 问数 agent; chat apps must enable BANK_CONSTRAINED_PLAN."
  },
  "systemParameters": {
    "s2.parser.bank.max-candidates": "1",
    "s2.parser.bank.plan.thinking.enable": "false"
  },
  "jvmSystemProperties": {
    "s2.parser.bank.plan.thinking.enable": "false"
  },
  "agentChatApps": {
    "BANK_CONSTRAINED_PLAN": { "enable": true },
    "S2SQL_PARSER": { "enable": true, "chatModelId": 1 },
    "EXECUTION_SQL_CORRECTOR": {
      "enable": true,
      "chatModelId": 1,
      "note": "Resilience for physical execution failures."
    },
    "S2SQL_CORRECTOR": { "enable": false },
    "PHYSICAL_SQL_CORRECTOR": { "enable": false }
  },
  "eval": {
    "officialEntry": "evaluation/bank_nl2sql/Run-OfficialBankEvaluation.ps1",
    "datasetVersion": "2.0.6",
    "primaryMetric": "caseAccuracy",
    "diagnosticMetrics": ["resultExact", "parseSuccessRate", "executionSuccessRate", "finalAnswerProcessorSuccessRate"],
    "fixedSmokeProfile": "evaluation/bank_nl2sql/official_runtime_evaluation_v3.json"
  },
  "evidencePolicy": {
    "historicalLocalReportsAreNotComparable": true,
    "requiredForNewClaim": "A fresh official Fact v3 run with bootstrap receipt and v2.0.6 package verification."
  },
  "notRecommended": {
    "s2.parser.bank.max-candidates": "2",
    "why": "Use only as an engineering comparison cell; promote no configuration without a fresh official Fact v3 run."
  }
}
