{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EcoMatch synthetic 360 metric fact",
  "schemaVersion": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataDate",
    "orgCode",
    "metricCode",
    "metricValue",
    "dataOrigin",
    "generatorVersion"
  ],
  "properties": {
    "dataDate": {"type": "string", "format": "date"},
    "orgCode": {"type": "string", "pattern": "^SYN-ORG-(?:00[1-9]|0[1-9][0-9]|1[0-3])$"},
    "metricCode": {"type": "string", "pattern": "^CNB(?:00[1-9]|0[1-9][0-9]|[12][0-9][0-9]|3[0-5][0-9]|360)$"},
    "metricValue": {"type": "number"},
    "dataOrigin": {"const": "SYNTHETIC"},
    "generatorVersion": {"const": "synthetic-360-v1"}
  }
}
