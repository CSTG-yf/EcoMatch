  "controls": [
    {
      "id": "identity-and-vertical-access",
      "description": "Authentication, administration and semantic object APIs reject anonymous or unauthorized callers.",
      "tests": [
        "user-token-access",
        "authorization-api-access",
        "authorization-policy-validation",
        "system-config-controller-access",
        "system-config-admin-guard",
        "evaluation-report-access",
        "dashboard-controller-identity",
        "dataset-access",
        "database-access",
        "model-access",
        "semantic-mutation-access",
        "tag-access",
        "term-access",
        "legacy-canvas-access",
        "chat-model-access"
      ]
    },
    {
      "id": "horizontal-object-access",
      "description": "Users cannot read another user's chat, query, agent, memory, plugin or configuration data.",
      "tests": [
        "chat-object-policy",
        "chat-history-access",
        "chat-query-access",
        "agent-access",
        "config-access",
        "memory-access",
        "plugin-access",
        "dashboard-object-access"
      ]
    },
    {
      "id": "row-and-column-permission",
      "description": "Row filters and sensitive column grants are scoped by model and fail closed.",
      "tests": [
        "authorization-policy-validation",
        "row-column-permission"
      ]
    },
    {
      "id": "dynamic-masking",
      "description": "Sensitive values use configured masking and preserve trustworthy masking metadata.",
      "tests": [
        "dynamic-masking",
        "masking-idempotence",
        "row-column-permission"
      ]
    },
    {
      "id": "cache-isolation",
      "description": "Cache keys isolate security scopes and cached results retain masked snapshots.",
      "tests": [
        "secure-query-cache",
        "chat-query-access"
      ]
    },
    {
      "id": "history-and-insight-leakage",
      "description": "History and business insight paths enforce ownership and exclude masked evidence.",
      "tests": [
        "chat-history-access",
        "chat-query-access",
        "insight-controller-access",
        "masked-insight",
        "result-projection"
      ]
    },
    {
      "id": "sensitive-log-leakage",
      "description": "Security-sensitive values do not appear in common or query logs.",
      "tests": [
        "sensitive-common-logging",
        "sensitive-query-logging"
      ]
    }
  ]
}
