{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": "../../..",
    "paths": {
      "@/services/request": ["src/pages/ControlledShare/request-shim.d.ts"],
      "@/*": ["src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["../../../src/typings.d.ts", "./*.ts", "./*.tsx"],
  "exclude": ["./*.test.ts"]
}
